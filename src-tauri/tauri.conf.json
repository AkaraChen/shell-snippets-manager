{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Shell Snippets Manager",
	"version": "0.1.0",
	"identifier": "com.akrc.shell-snippets-manager",
	"build": {
		"beforeDevCommand": "bun run prepare:sidecars && bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run prepare:sidecars && bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Shell Snippets Manager",
				"width": 1120,
				"height": 760,
				"dragDropEnabled": false,
				"backgroundColor": "#f5f5f5"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": [
			"binaries/shfmt"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
